{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MA3 Show Creator effect library",
  "description": "Generated by `showcreator library` from the MA3 predefined phaser file plus library/annotations.json.",
  "type": "object",
  "required": ["format", "version", "presets", "static_attributes"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "ma3sc-library" },
    "version": { "const": 1 },
    "source": { "type": "object" },
    "presets": {
      "type": "object",
      "description": "Semantic key -> preset.",
      "additionalProperties": { "$ref": "#/$defs/preset" }
    },
    "static_attributes": {
      "type": "object",
      "description": "Attributes a plan may set to a fixed value. Key -> MA3 attribute and range.",
      "additionalProperties": {
        "type": "object",
        "required": ["ma3", "cap", "min", "max"],
        "properties": {
          "ma3": { "type": "string" },
          "functions": { "type": "array", "items": { "type": "string" }, "description": "Set whichever of these channel functions each fixture has (instead of ma3)." },
          "cap": { "$ref": "#/$defs/cap" },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    }
  },
  "$defs": {
    "cap": {
      "enum": ["dimmer", "pan", "tilt", "color_mix", "color_wheel", "zoom", "focus", "gobo", "prism", "shutter", "strobe", "iris", "frost", "haze", "fog"]
    },
    "preset": {
      "type": "object",
      "required": ["pool", "index", "name", "kind", "affects", "requires"],
      "properties": {
        "pool": { "type": "integer", "minimum": 1 },
        "index": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "kind": { "enum": ["phaser", "static"] },
        "attributes": { "type": "array", "items": { "type": "string" } },
        "affects": { "type": "array", "items": { "enum": ["dimmer", "position", "color", "beam", "atmo"] } },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/cap" }, "description": "Every fixture the preset is applied to must have all of these." },
        "energy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
