    "Rnd Strobe":        { "energy": 1.0,  "tags": ["strobe", "random"] },
    "Circle":            { "energy": 0.5,  "tags": ["movement"] },
    "Circle Inverted":   { "energy": 0.5,  "tags": ["movement"] },
    "Eight":             { "energy": 0.6,  "tags": ["movement"] },
    "Eight Inverted":    { "energy": 0.6,  "tags": ["movement"] },
    "Tilt Sin":          { "energy": 0.45, "tags": ["movement", "wave"] },
    "Pan Sin":           { "energy": 0.45, "tags": ["movement", "wave"] },
    "Flyout":            { "energy": 0.8,  "tags": ["movement", "dimmer"] },
