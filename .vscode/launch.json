{
  // F5 runs the entry selected in the Run and Debug dropdown. Grouped: App, Build, Terminal (web UI in the
  // browser), Debug (breakpoints, needs the Java extension).
  // "node-terminal" is only used as a built-in way to run a shell command; no extension needed.
  "version": "0.2.0",
  "configurations": [
    // ---- App: the desktop window (backend inside, closes together with the window)
    {
      "name": "App: Desktop window",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -cp target/auto-ma3.jar automa3.desktop.DesktopMain",
      "presentation": { "group": "1 App", "order": 1 }
    },

    // ---- Build: self-contained Mac app (own Java runtime inside) + .dmg in target/dist
    {
      "name": "Build: Mac app + dmg",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "packaging/build-mac-app.sh && open target/dist",
      "presentation": { "group": "2 Build", "order": 1 }
    },
    {
      "name": "Build: Mac app + dmg, then start the app",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "packaging/build-mac-app.sh && open target/dist/AutoMA3.app",
      "presentation": { "group": "2 Build", "order": 2 }
    },
    {
      "name": "Build: jar + run all tests",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn clean package",
      "presentation": { "group": "2 Build", "order": 3 }
    },

    // ---- Terminal: backend in the terminal, web UI in the browser (http://127.0.0.1:8080/)
    {
      "name": "Terminal: Simulator (dry run)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --sim --dry-run",
      "presentation": { "group": "3 Terminal", "order": 1 }
    },
    {
      "name": "Terminal: Simulator -> console",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --sim",
      "presentation": { "group": "3 Terminal", "order": 2 }
    },
    {
      "name": "Terminal: Simulator 8x fast (dry run)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --sim --speed 8 --dry-run",
      "presentation": { "group": "3 Terminal", "order": 3 }
    },
    {
      "name": "Terminal: Live CDJs + record",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --record",
      "presentation": { "group": "3 Terminal", "order": 4 }
    },
    {
      "name": "Terminal: Replay last recording (dry run)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --dry-run --replay \"$(ls -t recordings/*.jsonl | head -1)\"",
      "presentation": { "group": "3 Terminal", "order": 5 }
    },

    // ---- Debug: run from the code with breakpoints (Java extension), no jar build
    {
      "name": "Debug: Desktop window",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.desktop.DesktopMain",
      "projectName": "auto-ma3",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "4 Debug", "order": 1 }
    },
    {
      "name": "Debug: Simulator (dry run)",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.Main",
      "projectName": "auto-ma3",
      "args": "--sim --dry-run",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "4 Debug", "order": 2 }
    },
    {
      "name": "Debug: Simulator 8x fast (dry run)",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.Main",
      "projectName": "auto-ma3",
      "args": "--sim --speed 8 --dry-run",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "4 Debug", "order": 3 }
    },
    {
      "name": "Debug: Replay the recording open in the editor (dry run)",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.Main",
      "projectName": "auto-ma3",
      "args": ["--dry-run", "--replay", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "4 Debug", "order": 4 }
    },
    {
      "name": "Debug: Live CDJs (dry run)",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.Main",
      "projectName": "auto-ma3",
      "args": "--dry-run",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "4 Debug", "order": 5 }
    }
  ]
}
