{
  // F5 runs the entry selected in the Run and Debug dropdown. Grouped: Run (web UI in the browser), Build,
  // Debug (breakpoints, needs the Java extension). Data (config, setups, recordings, logs) is in
  // ~/Library/Application Support/AutoMA3.
  // "node-terminal" is only used as a built-in way to run a shell command; no extension needed.
  "version": "0.2.0",
  "configurations": [
    // ---- Run: in the terminal, web UI in the browser (http://127.0.0.1:8081/, Cmd-click the link)
    {
      "name": "Run: Live CDJs (opens the browser)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --open",
      "presentation": { "group": "1 Run", "order": 0 }
    },
    {
      "name": "Run: Simulator (dry run)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --sim --dry-run",
      "presentation": { "group": "1 Run", "order": 1 }
    },
    {
      "name": "Run: Simulator -> console",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --sim",
      "presentation": { "group": "1 Run", "order": 2 }
    },
    {
      "name": "Run: Simulator 8x fast (dry run)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --sim --speed 8 --dry-run",
      "presentation": { "group": "1 Run", "order": 3 }
    },
    {
      "name": "Run: Live CDJs + record",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --record",
      "presentation": { "group": "1 Run", "order": 4 }
    },
    {
      "name": "Run: Replay last recording (dry run)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn -q clean package -DskipTests && java -jar target/auto-ma3.jar --dry-run --replay \"$(ls -t ~/Library/Application\\ Support/AutoMA3/recordings/*.jsonl | head -1)\"",
      "presentation": { "group": "1 Run", "order": 5 }
    },

    // ---- Build
    {
      "name": "Build: Mac release (zip with AutoMA3.command + own Java)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "packaging/build-mac-release.sh && open target/dist",
      "presentation": { "group": "2 Build", "order": 1 }
    },
    {
      "name": "Build: jar + run all tests",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": { "JAVA_HOME": "/opt/homebrew/opt/openjdk@21", "PATH": "/opt/homebrew/opt/openjdk@21/bin:${env:PATH}" },
      "command": "mvn clean package",
      "presentation": { "group": "2 Build", "order": 2 }
    },

    // ---- Debug: run from the code with breakpoints (Java extension), no jar build
    {
      "name": "Debug: Simulator (dry run)",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.Main",
      "projectName": "auto-ma3",
      "args": "--sim --dry-run",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3 Debug", "order": 1 }
    },
    {
      "name": "Debug: Simulator 8x fast (dry run)",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.Main",
      "projectName": "auto-ma3",
      "args": "--sim --speed 8 --dry-run",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3 Debug", "order": 2 }
    },
    {
      "name": "Debug: Replay the recording open in the editor (dry run)",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.Main",
      "projectName": "auto-ma3",
      "args": ["--dry-run", "--replay", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3 Debug", "order": 3 }
    },
    {
      "name": "Debug: Live CDJs (dry run)",
      "type": "java",
      "request": "launch",
      "mainClass": "automa3.Main",
      "projectName": "auto-ma3",
      "args": "--dry-run",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3 Debug", "order": 4 }
    }
  ]
}
